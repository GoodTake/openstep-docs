  "cards": [
    {
      "dot": "violet",
      "title": "Framework Agent",
      "items": [
        "Les auteurs figent règles, méthode et Skills dans une version de Product",
        "Les utilisateurs en créent un Agent : un plan de contrôle + 1..N Apps",
        "À chaque tour, la plateforme assemble instructions, Skills et MCP"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deux niveaux de contrôle",
      "items": [
        "Une phrase = une boucle d'outils du modèle",
        "Les grosses demandes suivent un plan ordonnancé par la plateforme : plan → validation → build · vérification · revue · correction → revue finale",
        "Toutes les Apps passent en ligne ensemble ; les données sont toujours conservées"
      ]
    },
    {
      "dot": "rose",
      "title": "Frontière de sécurité",
      "items": [
        "Le bac à sable ne reçoit le code qu'en prêt",
        "Clés, commits git et clés des modèles amont restent sur la plateforme",
        "Les jetons des comptes externes ne servent que via la plateforme"
      ]
    }
  ]
