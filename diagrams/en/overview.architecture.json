  "cards": [
    {
      "dot": "violet",
      "title": "Agent framework",
      "items": [
        "Authors freeze rules, method and skills into a Product version",
        "Users create an Agent from it: one control plane + 1..N Apps",
        "Each turn the platform assembles instructions, skills and MCP"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two levels of control",
      "items": [
        "One sentence = one model tool loop",
        "Big requests run as a platform-scheduled plan: plan → approve → build · check · review · fix → final review",
        "All Apps go live together; data is always kept"
      ]
    },
    {
      "dot": "rose",
      "title": "Security boundary",
      "items": [
        "The sandbox only gets code on loan",
        "Keys, git commits and upstream model keys stay on the platform",
        "Outside account tokens are used only through the platform"
      ]
    }
  ]
