---
import { sections } from '../sections.mjs';
import { href, inDir, localeDocs } from './docs';

const { locale, lang } = Astro.locals.starlightRoute;
const docs = await localeDocs(locale);

function formatCount(count: number, language: string) {
  switch (language) {
    case 'zh-TW':
      return `${count} 篇`;
    case 'ja':
      return `${count} 件`;
    case 'ko':
      return `${count}개 가이드`;
    case 'fr':
      return `${count} guides`;
    default:
      return `${count} ${count === 1 ? 'guide' : 'guides'}`;
  }
}

const groups = sections.map((section) => {
  const pages = section.dirs.flatMap((dir) => inDir(docs, dir)).map(([, doc]) => doc);
  const entry = docs.get(section.entrySlug) ?? pages[0];
  if (!entry) throw new Error(`HomeSections: no entry page for "${section.label}"`);
  return {
    label: section.translations[lang] ?? section.label,
    description: section.description[lang] ?? section.description.en,
    countLabel: formatCount(pages.length, lang),
    url: href(entry),
  };
});
---

<div class="home-sections not-content">
  {
    groups.map((group) => (
      <a class="home-section-card" href={group.url}>
        <div class="home-section-head">
          <h3>{group.label}</h3>
          <span class="arrow" aria-hidden="true">→</span>
        </div>
        <p class="home-section-desc">{group.description}</p>
        <span class="home-section-meta">{group.countLabel}</span>
      </a>
    ))
  }
</div>
